{
  "name": "ai-hub-community",
  "version": "0.5.7",
  "description": "Local multi-agent desktop workspace using your own AI accounts",
  "main": "main-bootstrap.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/unit-community.test.js tests/unit-community-onboarding.test.js tests/unit-community-hooks.test.js",
    "dist": "electron-builder --win --publish never",
    "doctor": "node scripts/doctor.js",
    "audit": "node scripts/audit-public.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.4.0",
    "marked": "^18.0.1",
    "node-pty": "^1.0.0",
    "prismjs": "^1.30.0",
    "uuid": "^10.0.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.0.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.ai-hub.community",
    "productName": "AI Hub Community",
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "claude-wx.ico",
      "artifactName": "AIHubCommunity-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "claude-wx.ico",
      "uninstallerIcon": "claude-wx.ico",
      "createDesktopShortcut": true,
      "artifactName": "AIHubCommunity-Setup-${version}.${ext}"
    },
    "files": [
      "main-bootstrap.js",
      "main.js",
      "main/**/*",
      "core/**/*",
      "renderer/**/*",
      "scripts/**/*",
      "!scripts/firewall-whitelist-electron.ps1",
      "claude-wx.ico",
      "package.json",
      "community-edition.json",
      "!node_modules/node-pty/deps/**",
      "!node_modules/node-pty/src/**",
      "!node_modules/node-pty/scripts/**",
      "!node_modules/node-pty/typings/**",
      "!node_modules/node-pty/binding.gyp"
    ],
    "asarUnpack": [
      "core/claude-fast-settings.json",
      "core/claude-subscription-fast-settings.json",
      "core/claude-subscription-standard-settings.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "**/*",
          "!firewall-whitelist-electron.ps1"
        ]
      },
      {
        "from": "docs",
        "to": "guides/docs",
        "filter": [
          "**/*.md"
        ]
      },
      {
        "from": ".",
        "to": "guides",
        "filter": [
          "README.md",
          "INSTALL.md",
          "AGENTS.md",
          "PRIVACY.md"
        ]
      }
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TianLin0509/ai-hub-codeagent.git"
  }
}
